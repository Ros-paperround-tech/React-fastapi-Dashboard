        <mxCell id="actions" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;PR: affected-only lint, types, tests, dev preview channel &#183; merge: build image once, deploy dev &#183; manual promote to QA &#183; approval-gated promote to prod (same image + bundles) &#183; rollback = previous tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
