  <diagram name="Layers" id="platform-layers">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="L_title" value="&lt;b&gt;Dashboard Platform&lt;/b&gt; &amp;#8212; the eleven layers (spec issue #1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="L_h1" value="&lt;b&gt;Flow layers&lt;/b&gt; &amp;#8212; requests travel down as far as Storage; data travels up as far as Storage; a request never reaches Analytics" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="36" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="L_h2" value="&lt;b&gt;Cross-cutting layers&lt;/b&gt; &amp;#8212; apply to every flow layer" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="36" width="660" height="24" as="geometry" />
        </mxCell>
        <mxCell id="L_frontend" value="&lt;b&gt;Frontend layer&lt;/b&gt; &amp;#8212; show data fast and consistently&lt;br&gt;React Dashboards &amp;#183; pages and charts &amp;#183; shared query hooks &amp;#183; browser cache (IndexedDB) &amp;#183; Firebase Hosting" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_contract" value="&lt;b&gt;Contract layer&lt;/b&gt; &amp;#8212; fix the shape of what may be asked and what each number means&lt;br&gt;named typed queries &amp;#183; generated TypeScript client &amp;#183; Measure catalogue (one definition and roll-up rule per Measure)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_access" value="&lt;b&gt;Access layer&lt;/b&gt; &amp;#8212; decide who may open which Dashboard, and remember how that changed&lt;br&gt;Firebase Authentication (Google, Workspace domain) &amp;#183; token verifier &amp;#183; Grants &amp;#183; Grant events (append-only) &amp;#183; admin Grant API + access review report" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_serving" value="&lt;b&gt;Serving layer&lt;/b&gt; &amp;#8212; answer Dashboard queries in milliseconds&lt;br&gt;FastAPI on Cloud Run &amp;#183; response cache keyed by Sync stamps &amp;#183; stamps endpoint &amp;#183; adds no business calculation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_storage" value="&lt;b&gt;Storage layer&lt;/b&gt; &amp;#8212; hold the served copy of the data (requests and data meet here)&lt;br&gt;PostgreSQL on Cloud SQL (Serving store) &amp;#183; synced tables + indexes &amp;#183; Grants + Grant events &amp;#183; sync log + Sync stamps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_sync" value="&lt;b&gt;Sync layer&lt;/b&gt; &amp;#8212; carry Source tables into Storage on schedule&lt;br&gt;Table syncs &amp;#183; Sync schedules + a default &amp;#183; atomic swap &amp;#183; freshness limits &amp;#183; own package + CLI (Cloud Run Job)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_analytics" value="&lt;b&gt;Analytics layer&lt;/b&gt; &amp;#8212; produce the numbers&lt;br&gt;BigQuery (Source) &amp;#183; final tables at chart grain &amp;#183; Measures calculated only here &amp;#183; data history and versioning" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L_standards" value="&lt;b&gt;Standards layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;make every Dashboard look and behave alike&lt;br&gt;&lt;br&gt;shared UI and chart packages&lt;br&gt;&lt;br&gt;lint rules that enforce them&lt;br&gt;&lt;br&gt;layout shell&lt;br&gt;&lt;br&gt;scaffolding generator&lt;br&gt;&lt;br&gt;one monorepo (pnpm + Turborepo, uv)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1110" y="70" width="150" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="L_infra" value="&lt;b&gt;Infrastructure layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;provide the environments everything runs in&lt;br&gt;&lt;br&gt;three GCP projects: dev, QA, prod&lt;br&gt;&lt;br&gt;Terraform, one module&lt;br&gt;&lt;br&gt;Secret Manager&lt;br&gt;&lt;br&gt;one service account per component&lt;br&gt;&lt;br&gt;region europe-west2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1280" y="70" width="150" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="L_delivery" value="&lt;b&gt;Delivery layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;move a change from pull request to prod&lt;br&gt;&lt;br&gt;GitHub Actions&lt;br&gt;&lt;br&gt;affected-only checks + Measure catalogue check&lt;br&gt;&lt;br&gt;preview deploys&lt;br&gt;&lt;br&gt;promote dev to QA to prod, same artefacts&lt;br&gt;&lt;br&gt;rollback = previous tag" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1450" y="70" width="150" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="L_obs" value="&lt;b&gt;Observability layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;record health and use, alert, retain&lt;br&gt;&lt;br&gt;structured request logs&lt;br&gt;&lt;br&gt;alerts: errors, latency, sync failure, freshness&lt;br&gt;&lt;br&gt;access log kept 13 months in an audit dataset&lt;br&gt;&lt;br&gt;last-used times for access review" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1620" y="70" width="150" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="L_e1" value="asks only through named queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#6c8ebf;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L_frontend" target="L_contract">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="170" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L_e2" value="request carries the ID token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#6c8ebf;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L_contract" target="L_access">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="170" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L_e3" value="allowed only with a Grant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#6c8ebf;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L_access" target="L_serving">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="170" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L_e4" value="SQL on a cache miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#6c8ebf;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L_serving" target="L_storage">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="170" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L_e5" value="tables read on a Sync schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#82b366;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="L_analytics" target="L_sync">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="170" y="0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L_e6" value="atomic swap + new Sync stamp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=2;strokeColor=#82b366;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="L_sync" target="L_storage">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="170" y="0" />
          </mxGeometry>
