        <mxCell id="L_lg2t" value="Data path: green arrows, bottom up to Storage" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="L_legend">
          <mxGeometry x="50" y="52" width="460" height="20" as="geometry" />
        </mxCell>
        <mxCell id="L_lg3" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="L_legend">
          <mxGeometry x="10" y="78" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="L_lg3t" value="Grey: cross-cutting layer; dashed: owned upstream" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="L_legend">
