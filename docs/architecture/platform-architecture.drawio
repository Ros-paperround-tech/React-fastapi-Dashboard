        <mxCell id="github" value="&lt;b&gt;GitHub monorepo (Platform)&lt;/b&gt;&lt;br&gt;pnpm + Turborepo, FastAPI with uv, Terraform, scaffolding generator" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
