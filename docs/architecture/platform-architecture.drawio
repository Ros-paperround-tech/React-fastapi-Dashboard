<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Flow" id="platform-architecture">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Dashboard Platform on Google Cloud&lt;/b&gt; &#8212; flow view: request path, caching, Table syncs, delivery (spec issue #1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1200" height="30" as="geometry" />
        </mxCell>

        <!-- People -->
        <mxCell id="viewer" value="&lt;b&gt;Dashboard viewer&lt;/b&gt;&lt;br&gt;business user, Google Workspace account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Platform admin&lt;/b&gt;&lt;br&gt;holds the reserved admin Grant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Browser tier -->
        <mxCell id="browser" value="Browser: one Dashboard app (React + Vite, shared UI / chart / auth / API-client packages)" style="swimlane;startSize=30;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;TanStack Query + persisted cache&lt;/b&gt;&lt;br&gt;IndexedDB, keys include Sync stamps&lt;br&gt;historic = never refetched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="browser">
          <mxGeometry x="20" y="50" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="&lt;b&gt;Pages and charts&lt;/b&gt;&lt;br&gt;layout shell, URL-bound filters, stale indicator, no-access page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="browser">
          <mxGeometry x="230" y="50" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="authc" value="&lt;b&gt;Auth client (Firebase SDK)&lt;/b&gt;&lt;br&gt;ID token + custom claims&lt;br&gt;route guard by Dashboard key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="browser">
          <mxGeometry x="440" y="50" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- External source -->
        <mxCell id="bigquery" value="&lt;b&gt;Source: BigQuery&lt;/b&gt;&lt;br&gt;final tables; Measures calculated only here" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="780" y="230" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- GCP project container -->
        <mxCell id="gcp" value="Google Cloud project &#8212; one per environment (dev, QA, prod), identical shape from one Terraform module, region europe-west2" style="swimlane;startSize=30;html=1;fillColor=#fafafa;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1600" height="790" as="geometry" />
        </mxCell>

        <!-- Firebase tier -->
        <mxCell id="fb" value="Firebase (project per environment)" style="swimlane;startSize=30;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="gcp">
          <mxGeometry x="20" y="50" width="640" height="150" as="geometry" />
        </mxCell>
        <mxCell id="hosting" value="&lt;b&gt;Firebase Hosting&lt;/b&gt;&lt;br&gt;one site per Dashboard; serves static bundle;&lt;br&gt;rewrites /api/* to Cloud Run (same origin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="fb">
          <mxGeometry x="20" y="40" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fbauth" value="&lt;b&gt;Firebase Authentication&lt;/b&gt;&lt;br&gt;Google sign-in, Workspace domain only;&lt;br&gt;custom claims = list of Dashboard keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="fb">
          <mxGeometry x="330" y="40" width="290" height="90" as="geometry" />
        </mxCell>

        <!-- API tier -->
        <mxCell id="api" value="Cloud Run: Platform API (FastAPI, one router module per Dashboard)" style="swimlane;startSize=30;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="gcp">
          <mxGeometry x="20" y="250" width="640" height="270" as="geometry" />
        </mxCell>
        <mxCell id="verifier" value="&lt;b&gt;Token verifier&lt;/b&gt;&lt;br&gt;Firebase Admin SDK; hosted-domain check server-side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="api">
          <mxGeometry x="20" y="40" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="grant" value="&lt;b&gt;Grant check + admin Grant API&lt;/b&gt;&lt;br&gt;route scoped to a Dashboard key; 401 / 403; each change appends a Grant event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="api">
          <mxGeometry x="230" y="40" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="routers" value="&lt;b&gt;Named queries&lt;/b&gt;&lt;br&gt;typed rows of Measures from the catalogue; historic | current; OpenAPI drives TS client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="api">
          <mxGeometry x="440" y="40" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="version" value="&lt;b&gt;Stamps endpoint&lt;/b&gt;&lt;br&gt;Sync stamp per table; polled cheaply by the browser; stamp headers on every response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="api">
          <mxGeometry x="20" y="150" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lru" value="&lt;b&gt;Response cache&lt;/b&gt;&lt;br&gt;in-memory LRU keyed by query + params + Sync stamps; ETag + Cache-Control by freshness class" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="api">
          <mxGeometry x="440" y="150" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Serving store tier -->
        <mxCell id="storelane" value="PostgreSQL on Cloud SQL (managed Postgres; same region, IAM auth, pooled; JSONB + pgvector available)" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="gcp">
          <mxGeometry x="20" y="560" width="640" height="200" as="geometry" />
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;Serving store&lt;/b&gt;&lt;br&gt;synced tables + indexes &#183; Grants + Grant events &#183; sync_log holding each table's Sync stamp" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="storelane">
          <mxGeometry x="40" y="40" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="storenote" value="A table's Sync stamp (set when its Table sync succeeds) is the cache key at every layer: IndexedDB, ETag, LRU. No explicit invalidation." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="storelane">
          <mxGeometry x="40" y="148" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Replication tier -->
        <mxCell id="repl" value="Sync component (own package + CLI, Cloud Run Job, settings-driven)" style="swimlane;startSize=30;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="gcp">
          <mxGeometry x="720" y="50" width="520" height="710" as="geometry" />
        </mxCell>
        <mxCell id="job" value="&lt;b&gt;Cloud Run Job: sync&lt;/b&gt;&lt;br&gt;runs every Table sync on the invoked Sync schedule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="20" y="40" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sched" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;one trigger per Sync schedule, one default; on demand via CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="280" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Export&lt;/b&gt;&lt;br&gt;BigQuery table to Parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="20" y="150" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gcs" value="&lt;b&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;Parquet exports" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="280" y="145" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Load staging table&lt;/b&gt;&lt;br&gt;build indexes from sync settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="20" y="260" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="&lt;b&gt;3. Row count&lt;br&gt;matches Source?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="20" y="370" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="&lt;b&gt;Keep previous table&lt;/b&gt;&lt;br&gt;stale, never broken; alert owner contact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="280" y="385" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Swap into Serving store&lt;/b&gt;&lt;br&gt;staging to live in one transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="20" y="500" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Record and publish&lt;/b&gt;&lt;br&gt;write sync_log; set this table's Sync stamp in the Serving store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="repl">
          <mxGeometry x="20" y="610" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Ops tier -->
        <mxCell id="ops" value="Platform services" style="swimlane;startSize=30;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="gcp">
          <mxGeometry x="1300" y="50" width="280" height="710" as="geometry" />
        </mxCell>
        <mxCell id="monitoring" value="&lt;b&gt;Cloud Monitoring + Logging&lt;/b&gt;&lt;br&gt;request log kept 13 months in audit dataset; alerts: 5xx, p95, sync failure, freshness limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="ops">
          <mxGeometry x="20" y="40" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;API secrets; nothing in repo or artefacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="ops">
          <mxGeometry x="20" y="150" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;API and sync images built once, promoted by tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="ops">
